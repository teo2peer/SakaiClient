  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "pdf:assets": "bun ./scripts/generate-pdf-assets.mjs",
    "start": "bun run pdf:assets && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "bun run pdf:assets && expo run:android",
    "ios": "bash ./scripts/build-sign-ios.sh --install",
    "ios:build": "bash ./scripts/build-sign-ios.sh",
    "build:ios:ci": "bash ./scripts/build-ios-ci.sh",
    "build:web": "bun run pdf:assets && expo export --platform web --output-dir dist/web",
    "desktop": "bun run build:web && electron desktop",
    "desktop:build": "node ./desktop/build.cjs",
    "web": "bun run pdf:assets && expo start --web",
    "lint": "expo lint",
    "typecheck": "bun run pdf:assets && tsc --noEmit",
    "test": "bun test"
  },
  "private": true
